# ==========================================
# Aura Desk environment configuration
# ==========================================
# Copy this file to .env and replace the placeholders with real values.
# Do NOT commit .env to version control.

# ---- Application ----
AURA_ENVIRONMENT=local
AURA_DEBUG=false
AURA_LOG_LEVEL=INFO

# ---- Database ----
AURA_DATABASE_URL=postgresql+asyncpg://aura:aura@localhost:5432/aura_desk

# ---- LLM ----
AURA_LLM_API_KEY=sk-...
AURA_LLM_BASE_URL=https://api.deepseek.com/v1
AURA_LLM_MODEL=deepseek-chat

# ---- TTS ----
AURA_TTS_VOICE=zh-CN-XiaoxiaoNeural
